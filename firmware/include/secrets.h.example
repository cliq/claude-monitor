#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to secrets.h and fill in your values before flashing.
// secrets.h is gitignored so your WiFi credentials never get committed.
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// The Claude Monitor macOS app serves this on your LAN (Settings → Usage).
// Use the Mac's LAN IP and the bridge port (default 8737).
#define BRIDGE_URL "http://10.0.1.7:8737/usage"

#endif
